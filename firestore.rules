rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidScore(data) {
      return data.playerName is string 
          && data.playerName.size() >= 1 
          && data.playerName.size() <= 50 
          && data.score is number
          && data.score >= 0;
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isValidScore(incoming());
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
