{
  "entities": {
    "Score": {
      "title": "Score",
      "description": "Represents a player's score entry.",
      "type": "object",
      "properties": {
        "playerName": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[a-zA-Z0-9 ]+$" },
        "score": { "type": "number" },
        "timestamp": { "type": "number", "description": "Server timestamp" }
      },
      "required": ["playerName", "score", "timestamp"]
    }
  },
  "firestore": {
    "scores": {
      "schema": "Score",
      "description": "Collection of all player scores."
    }
  }
}
